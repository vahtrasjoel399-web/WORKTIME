# ─────────────────────────────────────────────────────────────────────────────
# Copy to apps/mobile/.env and apps/admin/.env.local and fill in.
# Values with EXPO_PUBLIC_ / NEXT_PUBLIC_ prefixes are shipped to the client and
# are safe ONLY because Row Level Security protects the data. The service_role
# key is NEVER a public var and NEVER goes into the mobile app.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (get from Dashboard → Project Settings → API) ──
# Mobile app:
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# Admin panel:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Admin panel SERVER ONLY — used for CSV/XLSX exports and GDPR erasure.
# Do NOT prefix with NEXT_PUBLIC_. Do NOT put in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# ── Maps (admin) ──
# Optional. If empty, the admin falls back to free CARTO/OSM raster tiles.
# Must be NEXT_PUBLIC_ so the browser map can read it.
NEXT_PUBLIC_MAPTILER_KEY=

# ── Edge Function auth ──
# Shared secret the pg_cron job sends to the close-stale-shifts function.
CRON_SECRET=change-me-to-a-long-random-string
